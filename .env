# ============================================================
# Email — Postmark API (OTP / verification delivery)
# SMTP/nodemailer is fully removed — Postmark HTTPS API only.
# Paste the SAME values already set on Render → backend service →
# Environment (never the frontend service). Only enable real
# sending after anistrim.com shows "Verified" in Postmark DNS.
#   POSTMARK_SERVER_TOKEN  = Postmark Server API token (from Postmark dashboard)
#   POSTMARK_FROM_EMAIL    = admin@anistrim.com (must be on verified domain)
#   POSTMARK_FROM_NAME     = AniStrim
#   POSTMARK_MESSAGE_STREAM = outbound
# ============================================================
POSTMARK_SERVER_TOKEN=REPLACE_WITH_POSTMARK_SERVER_TOKEN
POSTMARK_FROM_EMAIL=admin@anistrim.com
POSTMARK_FROM_NAME=AniStrim
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_TIMEOUT_MS=12000

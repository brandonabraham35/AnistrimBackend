# ============================================================
# Email — Mailgun HTTP API (OTP / verification delivery)
# SMTP/nodemailer is fully removed — Mailgun HTTPS API only.
# Paste the SAME values already set on Render → backend service →
# Environment (never the frontend service). Only enable real
# sending after mg.anistrim.com shows "Verified" in Mailgun DNS.
#   MAILGUN_API_KEY      = Mailgun Domain Sending key (from Mailgun dashboard)
#   MAILGUN_DOMAIN       = mg.anistrim.com
#   MAILGUN_API_BASE_URL = https://api.eu.mailgun.net (EU region)
#                          or https://api.mailgun.net (US region)
#   MAILGUN_FROM_EMAIL   = verification@mg.anistrim.com
#   MAILGUN_FROM_NAME    = AniStrim
# ============================================================
MAILGUN_API_KEY=REPLACE_WITH_MAILGUN_DOMAIN_SENDING_KEY_FROM_RENDER
MAILGUN_DOMAIN=mg.anistrim.com
MAILGUN_API_BASE_URL=https://api.eu.mailgun.net
MAILGUN_FROM_EMAIL=verification@mg.anistrim.com
MAILGUN_FROM_NAME=AniStrim

# ============================================================
#  AniStrim2 — Environment Variables
#  Copy this file to .env and fill in your real values
#  NEVER commit .env to Git
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MySQL Database (MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=anistrim2

# JWT Secret — generate a long random string
JWT_SECRET=change_this_to_a_very_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# Stream Token Secret — REQUIRED in production (FIX 6).
# Dedicated HMAC key for short-lived stream tokens (utils/streamToken.js).
# MUST be independent of JWT_SECRET so a stream-token compromise can never
# become an auth-token compromise, and the two can be rotated separately.
# Generate with:
#   openssl rand -hex 32
# The server refuses to boot in production if this is missing.
STREAM_TOKEN_SECRET=change_this_to_a_64_char_random_hex_string

# Flutterwave (get keys from dashboard.flutterwave.com)
FLW_PUBLIC_KEY=FLWPUBK_TEST-XXXXXXXXXXXXXXXXXXXX-X
FLW_SECRET_KEY=FLWSECK_TEST-XXXXXXXXXXXXXXXXXXXX-X
FLW_ENCRYPTION_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
FLW_WEBHOOK_SECRET=your_webhook_secret_here

# Payment Plans (in UGX)
PREMIUM_MONTHLY_AMOUNT=35000
PREMIUM_YEARLY_AMOUNT=350000

# Frontend URL (for redirects after payment and password-reset links)
FRONTEND_URL=http://localhost:5000

# CORS allowed origins — comma-separated list of origins the API will accept
# requests from. This is the SINGLE source of truth for CORS. It is read by
# config/cors.js and used by server.js.
#
# Production example (web + admin + mobile + desktop):
#   API_ALLOWED_ORIGINS=https://anistrim.com,https://admin.anistrim.com,https://anistrimbackend.onrender.com
#
# Development example (local + Capacitor origins are auto-added when
# NODE_ENV !== 'production', so this can often be left blank in dev):
#   API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8100
#
# NOTE: Authentication uses Bearer JWT in the Authorization header. Cookies are
# NOT used, so credentials:true is intentionally disabled in CORS.
API_ALLOWED_ORIGINS=

# Email / Mailgun HTTP API - REQUIRED for OTP delivery in production.
# AniStrim uses Mailgun's HTTPS API (NOT SMTP, NOT Gmail). This avoids the
# Render → SMTP connectivity timeout by making a normal HTTPS request.
#   1. Create your Mailgun account + sending domain (e.g. mg.anistrim.com)
#   2. Verify DNS (SPF/DKIM/CNAME/MX) in the Mailgun dashboard
#   3. Create a Domain Sending API key
#   4. If your domain is in the EU region, use https://api.eu.mailgun.net
#      (US region: https://api.mailgun.net)
MAILGUN_API_KEY=key-your-mailgun-sending-key
MAILGUN_DOMAIN=mg.anistrim.com
MAILGUN_API_BASE_URL=https://api.eu.mailgun.net
MAILGUN_FROM_EMAIL=verification@mg.anistrim.com
MAILGUN_FROM_NAME=AniStrim

# Google OAuth - from Google Cloud Console (required for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
APP_SCHEME=anistrim
APP_PACKAGE=com.anistrim.render
BACKEND_URL=https://anistrimbackend.onrender.com

# Admin
ADMIN_EMAIL=admin@anistrim.com

# Cloudinary media storage and video delivery
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Automated catalogue providers. Kitsu works without a key; deploy Consumet
# yourself and set its private base URL. MalSync mapping is optional until a
# compatible MAL-ID bridge is configured.
REDIS_URL=redis://default:pY1jVyBmQFuc2c66et5eMyP6D2yJ8rNj@sincere-size-upbeat-53194.db.redis.io:19093
KITSU_BASE_URL=https://kitsu.io/api/edge
MALSYNC_BASE_URL=https://api.malsync.moe
CONSUMET_BASE_URL=https://your-private-consumet-service.example
PROVIDER_TIMEOUT_MS=8000

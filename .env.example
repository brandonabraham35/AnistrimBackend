# ============================================================
#  AniStrim2 - Environment Variables
#  Copy this file to .env and fill in your real values
#  NEVER commit .env to Git
# ============================================================

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=anistrim2

# JWT Secret - generate a long random string
JWT_SECRET=change_this_to_a_very_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=7d
JWT_ISSUER=anistrim
JWT_AUDIENCE=anistrim-api

# Password-Reset JWT Secret - REQUIRED in production.
# Dedicated secret for password-reset tokens, independent of JWT_SECRET.
# Generate with: openssl rand -hex 32
JWT_RESET_SECRET=change_this_to_a_64_char_random_hex_string

# Stream Token Secret - REQUIRED in production.
# Dedicated HMAC key for short-lived stream tokens (utils/streamToken.js).
# Generate with: openssl rand -hex 32
STREAM_TOKEN_SECRET=change_this_to_a_64_char_random_hex_string

# Password pepper - additional HMAC salt for password hashing (optional but recommended)
PASSWORD_PEPPER=change_this_to_a_long_random_string

# Flutterwave (get keys from dashboard.flutterwave.com)
FLW_PUBLIC_KEY=FLWPUBK_TEST-XXXXXXXXXXXXXXXXXXXX-X
FLW_SECRET_KEY=FLWSECK_TEST-XXXXXXXXXXXXXXXXXXXX-X
FLW_ENCRYPTION_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
FLW_WEBHOOK_SECRET=your_webhook_secret_here

# Payment Plans (in UGX)
PREMIUM_MONTHLY_AMOUNT=35000
PREMIUM_YEARLY_AMOUNT=350000

# Pesapal API 3.0
PESAPAL_ENV=live
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_IPN_ID=your_existing_pesapal_ipn_id

# Frontend URL (for redirects after payment and password-reset links)
FRONTEND_URL=http://localhost:5000
BACKEND_URL=https://anistrimbackend.onrender.com
PUBLIC_API_URL=
RENDER_EXTERNAL_URL=

# Presentation-decoupling (client-agnostic API):
PASSWORD_RESET_PATH=
GOOGLE_AUTH_DEEP_LINK=
RESET_PATHS_JSON=
GOOGLE_RETURN_TARGETS_JSON=
PAYMENT_RETURN_TARGETS_JSON=

# Static serving
SERVE_STATIC_FRONTEND=true
SERVE_FRONTEND=true
SERVE_ADMIN=true
FRONTEND_DIR=Frontend
ADMIN_DIR=AdminDashboard
SERVE_WEB=true
WEB_DIR=Web
WEB_MOUNT_PATH=/web
SERVE_DESKTOP_PREVIEW=false
DESKTOP_DIR=Desktop
DESKTOP_ORIGINS=app://anistrim-desktop,anistrim-desktop://auth

# Host-based routing (optional)
PRIMARY_HOST_WEB=
PRIMARY_HOST_MOBILE=

# CORS allowed origins - comma-separated. Single source of truth (config/cors.js)
API_ALLOWED_ORIGINS=https://anistrim.com,https://www.anistrim.com,https://admin.anistrim.com,https://anistrimbackend.onrender.com,https://anistrim-one.vercel.app

# Email / Postmark API - REQUIRED for OTP delivery in production.
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_FROM_EMAIL=admin@anistrim.com
POSTMARK_FROM_NAME=AniStrim
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_TIMEOUT_MS=12000
POSTMARK_TEST_MODE=false

# Google OAuth - from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
APP_SCHEME=anistrim
APP_PACKAGE=com.anistrim.render

# Admin (bootstrap admin account)
ADMIN_EMAIL=admin@anistrim.com
DEFAULT_ADMIN_EMAIL=admin@anistrim.com
DEFAULT_ADMIN_PASSWORD=change_this_admin_password

# Cloudinary media storage and video delivery
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis (optional; used for stream cache / rate limiting)
# Format: redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT

# Automated catalogue providers
KITSU_BASE_URL=https://kitsu.io/api/edge
MALSYNC_BASE_URL=https://api.malsync.moe
CONSUMET_BASE_URL=https://your-private-consumet-service.example
CONSUMET_API_URL=
CONSUMET_HOSTED_INFO_PATH=/info
CONSUMET_HOSTED_SEARCH_PATH=/search
CONSUMET_HOSTED_SOURCES_PATH=/watch
CONSUMET_HOSTED_TIMEOUT_MS=10000
ANIMESKIP_API_KEY=your_animeskip_api_key

# AnimeHeaven provider tuning
ANIMEHEAVEN_BASE_URL=https://animeheaven.eu
ANIMEHEAVEN_DAILY_REFRESH_MS=86400000
ANIMEHEAVEN_MAX_NESTED_DEPTH=3
ANIMEHEAVEN_MIRROR_CACHE_TTL_MS=3600000
ANIMEHEAVEN_STALE_MS=86400000
ANIMEHEAVEN_SEARCH_DEBUG=false
PROVIDER_TIMEOUT_MS=8000

# Premium automation
PREMIUM_AUTOMATION_ENABLED=false

# Stream cache & monitoring
STREAM_CACHE_ENABLED=true
STREAM_CACHE_PROVIDER=animeheaven
STREAM_CACHE_TTL_MINUTES=360
STREAM_CACHE_TTL_SECONDS=21600
STREAM_CACHE_MEMORY_TTL_MS=600000
STREAM_CACHE_RESOLVER_TIMEOUT_MS=15000
STREAM_CACHE_SOURCE_PROBE_TIMEOUT_MS=20000
STREAM_CACHE_SWEEP_INTERVAL_MS=60000
STREAM_VERIFICATION_INTERVAL_MINUTES=30
STREAM_CONCURRENCY=8
STREAM_PIPELINE_TIMEOUT_MS=20000
STREAM_VERIFY_TIMEOUT_MS=15000
STREAM_LONG_LIVED_THRESHOLD_HOURS=24
STREAM_PROVIDERS=animeheaven
STREAM_MONITOR_ENABLED=true
STREAM_MONITOR_INTERVAL_MINUTES=30
STREAM_MONITOR_MIN_INTERVAL_MINUTES=5
STREAM_MONITOR_BATCH_SIZE=50
STREAM_MONITOR_CONCURRENCY=8
STREAM_MONITOR_TIMEOUT_MS=20000
STREAM_MONITOR_MAX_SOURCES=10000
STREAM_OBSERVATION_INTERVAL_MINUTES=15
STREAM_OBSERVATION_CONCURRENCY=8
STREAM_OBSERVATION_TIMEOUT_MS=20000
STREAM_PROXY_MAX_CONTEXTS=50
STREAM_PROXY_TTL_MS=3600000
STREAM_DEBUG=false
STREAM_DIAGNOSTIC=false

# Streaming proxy (optional upstream HTTP proxy)
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
PROXY_LIST=
PROXY_DIAGNOSTICS=false

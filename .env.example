# ============================================================
#  AniStrim2 — Environment Variables
#  Copy this file to .env and fill in your real values
#  NEVER commit .env to Git
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MySQL Database (MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=anistrim2

# JWT Secret — generate a long random string
JWT_SECRET=change_this_to_a_very_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# Stream Token Secret — REQUIRED in production (FIX 6).
# Dedicated HMAC key for short-lived stream tokens (utils/streamToken.js).
# MUST be independent of JWT_SECRET so a stream-token compromise can never
# become an auth-token compromise, and the two can be rotated separately.
# Generate with:
#   openssl rand -hex 32
# The server refuses to boot in production if this is missing.
STREAM_TOKEN_SECRET=change_this_to_a_64_char_random_hex_string

# Flutterwave (get keys from dashboard.flutterwave.com)
FLW_PUBLIC_KEY=FLWPUBK_TEST-XXXXXXXXXXXXXXXXXXXX-X
FLW_SECRET_KEY=FLWSECK_TEST-XXXXXXXXXXXXXXXXXXXX-X
FLW_ENCRYPTION_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
FLW_WEBHOOK_SECRET=your_webhook_secret_here

# Payment Plans (in UGX)
PREMIUM_MONTHLY_AMOUNT=35000
PREMIUM_YEARLY_AMOUNT=350000

# Frontend URL (for redirects after payment and password-reset links)
FRONTEND_URL=http://localhost:5000

# Presentation-decoupling (client-agnostic API):
# --------------------------------------------------------------------
# Legacy single-value settings — DEPRECATED. Use the per-client maps below.
PASSWORD_RESET_PATH=
GOOGLE_AUTH_DEEP_LINK=

# Multi-client settings (B7 fix):
# Per-client password-reset paths and Google OAuth return targets, keyed by
# client identifier (mobile|web|desktop|admin). Values are validated against
# strict allow-lists — never reflect caller-supplied URLs.
#
# RESET_PATHS_JSON:
#   {"mobile":"/reset-password.html","web":"https://anistrim-one.vercel.app/#/reset-password","desktop":"/reset-password","admin":"/admin/reset-password"}
#
# GOOGLE_RETURN_TARGETS_JSON:
#   {"mobile":"anistrim://auth","web":"https://anistrim-one.vercel.app/#/auth/google/callback","desktop":"anistrim-desktop://auth","admin":"/admin/google-callback.html"}
#
# PAYMENT_RETURN_TARGETS_JSON:
#   {"mobile":"/payment-callback.html","web":"https://anistrim-one.vercel.app/#/payment-return","desktop":"anistrim-desktop://payment-return","admin":"/admin/"}
RESET_PATHS_JSON=
GOOGLE_RETURN_TARGETS_JSON=
PAYMENT_RETURN_TARGETS_JSON=

# SERVE_STATIC_FRONTEND: true keeps serving Frontend/ + AdminDashboard/ from this
#   repo (current local-dev behavior). Set false for API-only deployments so the
#   API and the frontend(s) can be deployed independently.
SERVE_STATIC_FRONTEND=true
# FRONTEND_DIR / ADMIN_DIR: directories to serve when static serving is enabled
#   (dev convenience).
FRONTEND_DIR=Frontend
ADMIN_DIR=AdminDashboard

# Web client serving (B3 fix):
# SERVE_WEB: whether to serve the Web/ browser SPA (defaults to SERVE_STATIC_FRONTEND)
SERVE_WEB=true
# WEB_DIR: location of the Web SPA static files
WEB_DIR=Web
# WEB_MOUNT_PATH: URL path prefix for the Web SPA (e.g. /web)
WEB_MOUNT_PATH=/web

# Desktop preview serving (B6 fix, optional — for testing Electron renderer):
# SERVE_DESKTOP_PREVIEW=true serves Desktop/ at /desktop-preview in a browser.
SERVE_DESKTOP_PREVIEW=false
DESKTOP_DIR=Desktop

# Desktop app origins (Electron packaged builds) — comma-separated:
# Custom schemes used by packaged Electron apps make the Origin header
# something like app://anistrim-desktop. Add them here.
DESKTOP_ORIGINS=app://anistrim-desktop,anistrim-desktop://auth

# Host-based routing (optional):
# If PRIMARY_HOST_WEB is set, requests with that Host header get Web/ at /.
# PRIMARY_HOST_MOBILE: Host header that gets Frontend/ at /.
# Example: PRIMARY_HOST_WEB=web.anistrim.com, PRIMARY_HOST_MOBILE=m.anistrim.com
PRIMARY_HOST_WEB=
PRIMARY_HOST_MOBILE=

# CORS allowed origins — comma-separated list of origins the API will accept
# requests from. This is the SINGLE source of truth for CORS. It is read by
# config/cors.js and used by server.js.
#
# Production example (web + admin + mobile + desktop):
#   API_ALLOWED_ORIGINS=https://anistrim.com,https://www.anistrim.com,https://admin.anistrim.com,https://anistrimbackend.onrender.com,https://anistrim-one.vercel.app
#
# Development example (local + Capacitor origins are auto-added when
# NODE_ENV !== 'production', so this can often be left blank in dev):
#   API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8100
#
# NOTE: Native WebView origins (capacitor://localhost, https://localhost,
# ionic://localhost) are ALWAYS allowed regardless of NODE_ENV — they are not
# browser origins and cannot be exploited with credentials:false + Bearer auth.
#
# NOTE: Authentication uses Bearer JWT in the Authorization header. Cookies are
# NOT used, so credentials:true is intentionally disabled in CORS.
API_ALLOWED_ORIGINS=https://anistrim.com,https://www.anistrim.com,https://admin.anistrim.com,https://anistrimbackend.onrender.com,https://anistrim-one.vercel.app

# Email / Mailgun HTTP API - REQUIRED for OTP delivery in production.
# AniStrim uses Mailgun's HTTPS API (NOT SMTP, NOT Gmail). This avoids the
# Render → SMTP connectivity timeout by making a normal HTTPS request.
#   1. Create your Mailgun account + sending domain (e.g. mg.anistrim.com)
#   2. Verify DNS (SPF/DKIM/CNAME/MX) in the Mailgun dashboard
#   3. Create a Domain Sending API key
#   4. If your domain is in the EU region, use https://api.eu.mailgun.net
#      (US region: https://api.mailgun.net)
MAILGUN_API_KEY=key-your-mailgun-sending-key
MAILGUN_DOMAIN=mg.anistrim.com
MAILGUN_API_BASE_URL=https://api.eu.mailgun.net
MAILGUN_FROM_EMAIL=verification@mg.anistrim.com
MAILGUN_FROM_NAME=AniStrim

# Google OAuth - from Google Cloud Console (required for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
APP_SCHEME=anistrim
APP_PACKAGE=com.anistrim.render
BACKEND_URL=https://anistrimbackend.onrender.com

# Admin
ADMIN_EMAIL=admin@anistrim.com

# Cloudinary media storage and video delivery
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Automated catalogue providers. Kitsu works without a key; deploy Consumet
# yourself and set its private base URL. MalSync mapping is optional until a
# compatible MAL-ID bridge is configured.
REDIS_URL=redis://default:pY1jVyBmQFuc2c66et5eMyP6D2yJ8rNj@sincere-size-upbeat-53194.db.redis.io:19093
KITSU_BASE_URL=https://kitsu.io/api/edge
MALSYNC_BASE_URL=https://api.malsync.moe
CONSUMET_BASE_URL=https://your-private-consumet-service.example
PROVIDER_TIMEOUT_MS=8000

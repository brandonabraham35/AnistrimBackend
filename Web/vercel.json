{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.anistrim.com"
        }
      ],
      "destination": "https://anistrim.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://anistrimbackend.onrender.com/api/:path*",
      "headers": [
        { "key": "x-vercel-secret", "value": "${VERCEL_SECRET}" }
      ]
    },
    {
      "source": "/robots.txt",
      "destination": "https://anistrimbackend.onrender.com/robots.txt",
      "headers": [
        { "key": "x-vercel-secret", "value": "${VERCEL_SECRET}" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://anistrimbackend.onrender.com/sitemap.xml",
      "headers": [
        { "key": "x-vercel-secret", "value": "${VERCEL_SECRET}" }
      ]
    },
    {
      "source": "/anime/:id",
      "destination": "https://anistrimbackend.onrender.com/anime/:id",
      "headers": [
        { "key": "x-vercel-secret", "value": "${VERCEL_SECRET}" }
      ]
    },
    {
      "source": "/browse",
      "destination": "https://anistrimbackend.onrender.com/browse",
      "headers": [
        { "key": "x-vercel-secret", "value": "${VERCEL_SECRET}" }
      ]
    },
    {
      "source": "/search",
      "destination": "https://anistrimbackend.onrender.com/search",
      "headers": [
        { "key": "x-vercel-secret", "value": "${VERCEL_SECRET}" }
      ]
    },
    {
      "source": "/genre/:name",
      "destination": "https://anistrimbackend.onrender.com/genre/:name",
      "headers": [
        { "key": "x-vercel-secret", "value": "${VERCEL_SECRET}" }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

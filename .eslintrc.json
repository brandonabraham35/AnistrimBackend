{
    "env": {
        "commonjs": true,
        "es2021": true,
        "node": true,
        "mocha": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": "latest"
    },
    "rules": {
        "no-unused-vars": ["warn", { "args": "none" }],
        "no-console": "off",
        "semi": ["error", "always"],
        "quotes": "off",
        "no-undef": "error",
        "no-empty": "off",
        "no-useless-escape": "off",
        "no-unreachable": "warn",
        "no-redeclare": "warn"
    },
    "ignorePatterns": [
        "node_modules/",
        "AdminDashboard/",
        "Frontend/",
        "Web/",
        "Desktop/",
        "android/",
        "ios/",
        "tmp/",
        "*.min.js",
        "/_*.js",
        "scripts/capacitor-preflight.js",
        "scripts/admin-dashboard-diagnostic.js",
        "scripts/diagnose-proxy.js"
    ]
}